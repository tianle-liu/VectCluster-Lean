import Verification.OriginalRetainedProductCoordinates
import Verification.AffineComponentUnitGeneration

/-!
# Original Stratum Unit Generation

Actual original-stratum units are generated by the whole retained
coefficient ring and selectors of original free coordinates. Both parts
are transported through the same proved ring equivalence, including the
actual coefficient inclusion and the actual component idempotents.
-/
noncomputable section
namespace Verification.OriginalStratumUnitGeneration
attribute [local instance] Classical.propDecidable
set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 1000000
open scoped BigOperators
open Verification.IndependentChartIndex Verification.OriginalFreeTorusCoordinates
variable (R κ : Type) [Field R] [Fintype κ] (n : ℕ) (I : Finset (Fin n))
variable (B : (Fin n ⊕ κ) → (Fin n ⊕ Empty) → ℤ)
variable (D : OriginalRetainedProductCoordinates.ProductData R κ n I B)
variable (hpos : ∀ a i : Fin n, ¬ a < i → (B (Sum.inl a) (Sum.inl i)).toNat = 0)
variable (hneg : ∀ a i : Fin n, ¬ i < a → (-B (Sum.inl a) (Sum.inl i)).toNat = 0)
variable (hsupport : ∀ i j, FrozenAcyclicCover.earlierWeights κ n B i j = 0 ↔
  FrozenAcyclicCover.laterWeights κ n B i j = 0)
variable (hI : ExchangeOpenCover.Independent (FrozenAcyclicCover.laterWeights κ n B) I)
local notation "A" => GlobalNormalFrame.ZeroLayer R κ n I B
local notation "S" => RemainingRing R κ n I B
local notation "K" => FreeIndex κ n I B
local notation "V" => Selected n I
local notation "E" => OriginalRetainedProductCoordinates.stratumEquiv R κ n I B D hpos hneg hsupport hI
local notation "inc" => OriginalRemainingCoordinates.inclusion R κ n I B hpos hneg hsupport hI

def transport : Aˣ ≃* (AffineComponentUnits.Ring D.Factor V K)ˣ :=
  Units.mapEquiv (E).toRingEquiv.toMulEquiv

def coefficientUnit (c : Sˣ) : Aˣ := Units.map (inc).toRingHom.toMonoidHom c

def indicator (j : D.Index) : A :=
  inc (ProductComponentIdempotents.indicator D.Factor D.equiv.toRingEquiv j)

theorem indicator_idempotent (j : D.Index) :
    indicator R κ n I B D hpos hneg hsupport hI j * indicator R κ n I B D hpos hneg hsupport hI j =
      indicator R κ n I B D hpos hneg hsupport hI j := by
  change inc _ * inc _ = inc _
  rw [← map_mul, ProductComponentIdempotents.indicator_idempotent]

def originalUnit (k : K) : Aˣ :=
  (transport R κ n I B D hpos hneg hsupport hI).symm
    (AffineComponentUnitGeneration.variableUnit D.Factor V K k)

theorem transport_originalUnit (k : K) :
    transport R κ n I B D hpos hneg hsupport hI
      (originalUnit R κ n I B D hpos hneg hsupport hI k) =
        AffineComponentUnitGeneration.variableUnit D.Factor V K k :=
  (transport R κ n I B D hpos hneg hsupport hI).apply_symm_apply _

theorem originalUnit_val (k : K) :
    (originalUnit R κ n I B D hpos hneg hsupport hI k : A) =
      ExplicitStratumCoordinates.original R κ n I B
        ((GlobalSelectedColumns.rowEquiv κ n I).symm k.val).val := by
  apply (E).injective
  have h := congrArg Units.val (transport_originalUnit R κ n I B D hpos hneg hsupport hI k)
  change E (originalUnit R κ n I B D hpos hneg hsupport hI k : A) = _ at h
  rw [h]
  funext j
  rw [AffineComponentUnitGeneration.variableUnit_val]
  exact (OriginalRetainedProductCoordinates.original_variable R κ n I B D hpos hneg hsupport hI k j).symm

def selector (j : D.Index) (k : K) : Aˣ :=
  BoundaryComponentSelector.unit (indicator R κ n I B D hpos hneg hsupport hI j)
    (indicator_idempotent R κ n I B D hpos hneg hsupport hI j)
    (originalUnit R κ n I B D hpos hneg hsupport hI k)

theorem selector_val (j : D.Index) (k : K) :
    (selector R κ n I B D hpos hneg hsupport hI j k : A) =
      1 - inc (ProductComponentIdempotents.indicator D.Factor D.equiv.toRingEquiv j) +
        inc (ProductComponentIdempotents.indicator D.Factor D.equiv.toRingEquiv j) *
          ExplicitStratumCoordinates.original R κ n I B
            ((GlobalSelectedColumns.rowEquiv κ n I).symm k.val).val := by
  change 1 - _ + _ * (originalUnit R κ n I B D hpos hneg hsupport hI k : A) = _
  rw [originalUnit_val]
  rfl

theorem transport_coefficient (c : Sˣ) :
    transport R κ n I B D hpos hneg hsupport hI (coefficientUnit R κ n I B hpos hneg hsupport hI c) =
      AffineComponentUnitGeneration.coefficient D.Factor V K
        ((Units.mapEquiv D.equiv.toRingEquiv.toMulEquiv) c) := by
  apply Units.ext
  funext j
  change E (inc (c : S)) j = _
  rw [OriginalRetainedProductCoordinates.coefficient, AffineComponentUnitGeneration.coefficient_val]
  rfl

theorem transport_indicator (j : D.Index) :
    E (indicator R κ n I B D hpos hneg hsupport hI j) =
      AffineComponentUnitGeneration.indicator D.Factor V K j := by
  change E (inc (ProductComponentIdempotents.indicator D.Factor D.equiv.toRingEquiv j)) = _
  rw [OriginalRetainedProductCoordinates.inclusion_indicator]
  exact ProductComponentIdempotents.image_indicator _ (E).toRingEquiv j

theorem transport_selector (j : D.Index) (k : K) :
    transport R κ n I B D hpos hneg hsupport hI
      (selector R κ n I B D hpos hneg hsupport hI j k) =
        AffineComponentUnitGeneration.selector D.Factor V K j k := by
  apply Units.ext
  have hx := congrArg Units.val (transport_originalUnit R κ n I B D hpos hneg hsupport hI k)
  change E (originalUnit R κ n I B D hpos hneg hsupport hI k : A) = _ at hx
  change E (1 - indicator R κ n I B D hpos hneg hsupport hI j +
    indicator R κ n I B D hpos hneg hsupport hI j *
      (originalUnit R κ n I B D hpos hneg hsupport hI k : A)) = _
  rw [map_add, map_sub, map_one, map_mul, transport_indicator, hx]
  exact (AffineComponentUnitGeneration.selector_ring_value D.Factor V K j k).symm

def constantPart (u : Aˣ) : Sˣ :=
  (Units.mapEquiv D.equiv.toRingEquiv.toMulEquiv).symm
    (AffineComponentUnitGeneration.constantPart D.Factor V K
      (transport R κ n I B D hpos hneg hsupport hI u))

def exponentPart (u : Aˣ) (j : D.Index) : K →₀ ℤ :=
  AffineComponentUnitGeneration.exponentPart D.Factor V K
    (transport R κ n I B D hpos hneg hsupport hI u) j

theorem decomposition (u : Aˣ) :
    u = coefficientUnit R κ n I B hpos hneg hsupport hI
        (constantPart R κ n I B D hpos hneg hsupport hI u) *
      ∏ j, ∏ k, selector R κ n I B D hpos hneg hsupport hI j k ^
        (exponentPart R κ n I B D hpos hneg hsupport hI u j k) := by
  apply (transport R κ n I B D hpos hneg hsupport hI).injective
  rw [map_mul, transport_coefficient]
  simp only [map_prod, map_zpow, transport_selector, constantPart, MulEquiv.apply_symm_apply, exponentPart]
  exact AffineComponentUnitGeneration.decomposition D.Factor V K
    (transport R κ n I B D hpos hneg hsupport hI u)

variable {G : Type*} [AddCommGroup G]

theorem additive_decomposition (f : Additive Aˣ →+ G) (u : Aˣ) :
    f (Additive.ofMul u) =
      f (Additive.ofMul (coefficientUnit R κ n I B hpos hneg hsupport hI
        (constantPart R κ n I B D hpos hneg hsupport hI u))) +
      ∑ j, ∑ k, (exponentPart R κ n I B D hpos hneg hsupport hI u j k) •
        f (Additive.ofMul (selector R κ n I B D hpos hneg hsupport hI j k)) := by
  calc
    f (Additive.ofMul u) = f (Additive.ofMul
      (coefficientUnit R κ n I B hpos hneg hsupport hI
        (constantPart R κ n I B D hpos hneg hsupport hI u) *
      ∏ j, ∏ k, selector R κ n I B D hpos hneg hsupport hI j k ^
        (exponentPart R κ n I B D hpos hneg hsupport hI u j k))) :=
          congrArg (fun v => f (Additive.ofMul v)) (decomposition R κ n I B D hpos hneg hsupport hI u)
    _ = _ := by simp only [ofMul_mul, ofMul_prod, ofMul_zpow, map_add, map_sum, map_zsmul]

#print axioms transport
#print axioms coefficientUnit
#print axioms indicator
#print axioms indicator_idempotent
#print axioms originalUnit
#print axioms transport_originalUnit
#print axioms originalUnit_val
#print axioms selector
#print axioms selector_val
#print axioms transport_coefficient
#print axioms transport_indicator
#print axioms transport_selector
#print axioms constantPart
#print axioms exponentPart
#print axioms decomposition
#print axioms additive_decomposition
end Verification.OriginalStratumUnitGeneration
