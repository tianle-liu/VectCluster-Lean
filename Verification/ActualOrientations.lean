import Verification.ActualProjectiveSplitting
import Verification.ModuleUnitAutomorphisms
import Mathlib.Algebra.Category.ModuleCat.ExteriorPower

/-!
# Actual Orientations

Orientations are actual trivializations of the top exterior power
of a finite projective module. Forgetting one is precisely the equivalence
relation generated by isomorphism and a unit change of trivialization.
-/
noncomputable section
namespace Verification.ActualOrientations
open CategoryTheory Verification.ActualProjectiveSplitting
variable (R : Type) [CommRing R] (r : ℕ)

structure Oriented where
  bundle : Bundle R
  rank : HasRank bundle r
  orientation : bundle.object.exteriorPower r ≅ ModuleCat.of R R

variable {R r}

def Equivalent (P Q : Oriented R r) : Prop := ∃ e : P.bundle.object ≅ Q.bundle.object,
  (ModuleCat.exteriorPower.functor R r).map e.hom ≫ Q.orientation.hom=P.orientation.hom

theorem equivalent_refl (P : Oriented R r) : Equivalent P P := by
  refine ⟨Iso.refl _,?_⟩
  change (ModuleCat.exteriorPower.functor R r).map (𝟙 P.bundle.object) ≫ P.orientation.hom=_
  rw [CategoryTheory.Functor.map_id,Category.id_comp]

theorem equivalent_symm {P Q : Oriented R r} (h : Equivalent P Q) : Equivalent Q P := by
  obtain ⟨e,he⟩ := h
  refine ⟨e.symm,?_⟩
  rw [← he,← Category.assoc,← CategoryTheory.Functor.map_comp]
  simp only [Iso.symm_hom,Iso.inv_hom_id,CategoryTheory.Functor.map_id,Category.id_comp]

theorem equivalent_trans {P Q S : Oriented R r} (h : Equivalent P Q) (k : Equivalent Q S) :
    Equivalent P S := by
  obtain ⟨e,he⟩ := h
  obtain ⟨f,hf⟩ := k
  refine ⟨e ≪≫ f,?_⟩
  change (ModuleCat.exteriorPower.functor R r).map (e.hom ≫ f.hom) ≫ S.orientation.hom=_
  rw [CategoryTheory.Functor.map_comp,Category.assoc,hf,he]

def setoid : Setoid (Oriented R r) where
  r := Equivalent
  iseqv := ⟨equivalent_refl,fun h => equivalent_symm h,fun h k => equivalent_trans h k⟩

def Classes := Quotient (setoid (R := R) (r := r))

def changeOrientation (u : Rˣ) (P : Oriented R r) : Oriented R r where
  bundle := P.bundle
  rank := P.rank
  orientation := P.orientation ≪≫ ModuleUnitAutomorphisms.multiplication R u

theorem underlying_iff_unit (P Q : Oriented R r) :
    Nonempty (P.bundle.object ≅ Q.bundle.object) ↔
      ∃ u : Rˣ,Equivalent (changeOrientation u P) Q := by
  constructor
  · rintro ⟨e⟩
    let a : ModuleUnitAutomorphisms.line R ≅ ModuleUnitAutomorphisms.line R :=
      P.orientation.symm ≪≫ (ModuleCat.exteriorPower.functor R r).mapIso e ≪≫ Q.orientation
    refine ⟨ModuleUnitAutomorphisms.unit a,e,?_⟩
    change (ModuleCat.exteriorPower.functor R r).map e.hom ≫ Q.orientation.hom=
      P.orientation.hom ≫ (ModuleUnitAutomorphisms.multiplication R (ModuleUnitAutomorphisms.unit a)).hom
    rw [ModuleUnitAutomorphisms.multiplication_unit]
    simp only [a,Iso.trans_hom,Iso.symm_hom,Category.assoc,Iso.hom_inv_id_assoc]
    rfl
  · rintro ⟨u,e,he⟩
    exact ⟨e⟩

#print axioms Oriented
#print axioms Equivalent
#print axioms equivalent_refl
#print axioms equivalent_symm
#print axioms equivalent_trans
#print axioms setoid
#print axioms Classes
#print axioms changeOrientation
#print axioms underlying_iff_unit
end Verification.ActualOrientations
