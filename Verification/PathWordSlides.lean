import Verification.PathWords

/-!
# Path Word Slides

Exact correspondence between literal binary-word slides 110 ↔ 011 and
the adjacent run transfers used by the path proof.
-/

namespace Verification.PathWordSlides

open Verification.Path Verification.PathWords

/-- Connectivity generated by the actual local monomial relation in any word context. -/
inductive WordConnected : List Bool → List Bool → Prop
  | refl (w) : WordConnected w w
  | slide (pre post : List Bool) :
      WordConnected (pre ++ true :: true :: false :: post)
        (pre ++ false :: true :: true :: post)
  | symm {u v} : WordConnected u v → WordConnected v u
  | trans {u v w} : WordConnected u v → WordConnected v w → WordConnected u w

theorem wordConnected_prefix (pre : List Bool) {u v : List Bool} (h : WordConnected u v) :
    WordConnected (pre ++ u) (pre ++ v) := by
  induction h with
  | refl w => exact WordConnected.refl _
  | slide p q => simpa only [List.append_assoc] using WordConnected.slide (pre ++ p) q
  | symm _ ih => exact WordConnected.symm ih
  | trans _ _ ih₁ ih₂ => exact WordConnected.trans ih₁ ih₂

theorem wordConnected_length {u v : List Bool} (h : WordConnected u v) : u.length=v.length := by
  induction h with
  | refl => rfl
  | slide => simp
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem runConnected_addHead {r s : List ℕ} (h : RunConnected r s)
    (hr : r ≠ []) (hs : s ≠ []) (k : ℕ) : RunConnected (addHead k r) (addHead k s) := by
  cases r with
  | nil => exact (hr rfl).elim
  | cons a r =>
    cases s with
    | nil => exact (hs rfl).elim
    | cons b s =>
      have hp := runConnected_parities h
      have hw := runConnected_sum h
      simp only [parities,List.map_cons,List.cons.injEq] at hp
      apply (runConnected_iff _ _).mpr
      constructor
      · simp only [addHead,parities,List.map_cons,List.cons.injEq]
        exact ⟨by omega,hp.2⟩
      · simp only [addHead,List.sum_cons] at *
        omega

theorem runs_prefix_connected (pre : List Bool) {u v : List Bool}
    (h : RunConnected (runs u) (runs v)) :
    RunConnected (runs (pre ++ u)) (runs (pre ++ v)) := by
  induction pre with
  | nil => exact h
  | cons b pre ih =>
    cases b
    · exact RunConnected.prepend 0 ih
    · exact runConnected_addHead ih (runs_ne_nil _) (runs_ne_nil _) 1

/-- Each literal local slide induces exactly one adjacent pair transfer. -/
theorem runs_slide (pre post : List Bool) :
    RunConnected (runs (pre ++ true :: true :: false :: post))
      (runs (pre ++ false :: true :: true :: post)) := by
  apply runs_prefix_connected
  cases h : runs post with
  | nil => exact (runs_ne_nil post h).elim
  | cons b tail =>
    simpa only [runs,h,addHead,Nat.zero_add,Nat.add_assoc] using RunConnected.slide 0 b tail

theorem runs_wordConnected {u v : List Bool} (h : WordConnected u v) :
    RunConnected (runs u) (runs v) := by
  induction h with
  | refl => exact RunConnected.refl _
  | slide pre post => exact runs_slide pre post
  | symm _ ih => exact RunConnected.symm ih
  | trans _ _ ih₁ ih₂ => exact RunConnected.trans ih₁ ih₂

/-- Every adjacent run transfer is a genuine local binary-word slide. -/
theorem encode_runConnected {r s : List ℕ} (h : RunConnected r s) :
    WordConnected (encode r) (encode s) := by
  induction h with
  | refl => exact WordConnected.refl _
  | slide a b tail =>
    have he : encode ((b+2) :: tail)=[true,true] ++ encode (b :: tail) :=
      encode_addHead 2 (b :: tail) (by simp)
    change WordConnected
      (List.replicate (a+2) true ++ false :: encode (b :: tail))
      (List.replicate a true ++ false :: encode ((b+2) :: tail))
    rw [he,List.replicate_add]
    simpa only [List.replicate_succ,List.replicate_zero,List.cons_append,List.nil_append,
      List.append_assoc] using WordConnected.slide (List.replicate a true) (encode (b :: tail))
  | symm _ ih => exact WordConnected.symm ih
  | trans _ _ ih₁ ih₂ => exact WordConnected.trans ih₁ ih₂
  | @prepend a r s h ih =>
    have hl : r.length=s.length := by
      simpa only [parities,List.length_map] using congrArg List.length (runConnected_parities h)
    cases r with
    | nil =>
      have hs : s=[] := List.length_eq_zero_iff.mp hl.symm
      subst s
      exact WordConnected.refl _
    | cons b r =>
      cases s with
      | nil => simp at hl
      | cons c s =>
        change WordConnected (List.replicate a true ++ false :: encode (b :: r))
          (List.replicate a true ++ false :: encode (c :: s))
        simpa only [List.append_assoc,List.singleton_append] using
          wordConnected_prefix (List.replicate a true ++ [false]) ih

/-- Parity classifies slides of the actual square-free monomial words, at fixed selected weight. -/
theorem wordConnected_iff (u v : List Bool) :
    WordConnected u v ↔ parities (runs u)=parities (runs v) ∧ u.count true=v.count true := by
  constructor
  · intro h
    have hr := runs_wordConnected h
    exact ⟨runConnected_parities hr,by simpa only [runs_sum] using runConnected_sum hr⟩
  · rintro ⟨hp,hw⟩
    have hr : RunConnected (runs u) (runs v) :=
      (runConnected_iff _ _).mpr ⟨hp,by simpa only [runs_sum] using hw⟩
    simpa only [encode_runs] using encode_runConnected hr

