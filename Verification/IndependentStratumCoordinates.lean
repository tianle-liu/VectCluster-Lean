import Verification.GlobalNormalFrame
import Verification.ActualTransverseClosed
import Verification.OpenZeroLayer

/-!
# Independent Stratum Coordinates

The actual zero stratum inside the principal open of the single global
exchange ring is transported to the explicit affine partner space over its
character fiber. The ideal is generated by the original coordinates and
is checked under the actual chart equivalence.
-/
noncomputable section
set_option synthInstance.maxHeartbeats 100000
namespace Verification.IndependentStratumCoordinates
open Verification.FrozenAcyclicCover Verification.IndependentChartIndex
open Verification.IndependentBasicOpen Verification.IndependentOpenCoordinates
open Verification.GlobalNormalFrame Verification.ActualOpenChart
open Verification.ExchangeOpenCover
variable (R κ : Type) [CommRing R] [Fintype κ] (n : ℕ) (I : Finset (Fin n))
variable (B : (Fin n ⊕ κ) → (Fin n ⊕ Empty) → ℤ)

instance zeroLayerAlgebra : Algebra R (ZeroLayer R κ n I B) :=
  inferInstanceAs (Algebra R (BasicOpen R κ n I B ⧸ zeroIdeal R κ n I B))

theorem map_zeroIdeal : (zeroIdeal R κ n I B).map (chartEquiv R κ n I B).toRingHom =
    ActualTransverseClosed.fullIdeal R (Selected n I) (Other n I ⊕ κ) (Other n I)
      Sum.inl (matrix κ n I B) := by
  rw [zeroIdeal,ConormalFrame.ideal,Ideal.map_span,← Set.range_comp,ActualTransverseClosed.fullIdeal]
  apply congrArg Ideal.span
  apply congrArg Set.range
  exact funext (chartEquiv_selectedCoordinate R κ n I B)

def quotientChart : ZeroLayer R κ n I B ≃ₐ[R]
    ActualTransverseClosed.FullClosed R (Selected n I) (Other n I ⊕ κ) (Other n I)
      Sum.inl (matrix κ n I B) :=
  Ideal.quotientEquivAlg _ _ (chartEquiv R κ n I B) (map_zeroIdeal R κ n I B).symm

theorem quotientChart_mk (z : BasicOpen R κ n I B) : quotientChart R κ n I B
    (Ideal.Quotient.mk (zeroIdeal R κ n I B) z) =
      Ideal.Quotient.mk _ (chartEquiv R κ n I B z) := rfl

def originalStratumEquiv : ZeroLayer R κ n I B ≃+*
    ActualStratum.GlobalZeroStratum R (Selected n I) (Other n I ⊕ κ) (Other n I)
      Sum.inl (matrix κ n I B) :=
  (quotientChart R κ n I B).toRingEquiv.trans
    (OpenZeroLayer.stratumEquiv R (Selected n I) (Other n I ⊕ κ) (Other n I)
      Sum.inl (matrix κ n I B))

variable (hpos : ∀ a i : Fin n, ¬ a < i → (B (Sum.inl a) (Sum.inl i)).toNat = 0)
variable (hneg : ∀ a i : Fin n, ¬ i < a → (-B (Sum.inl a) (Sum.inl i)).toNat = 0)
variable (hsupport : ∀ i j, earlierWeights κ n B i j = 0 ↔ laterWeights κ n B i j = 0)
variable (hI : Independent (laterWeights κ n B) I)

def affineEquiv : ZeroLayer R κ n I B ≃ₐ[R]
    MvPolynomial (Selected n I) (ExchangeTransverseSlice.Fiber
      (characters R (Selected n I) (Other n I ⊕ κ) (Other n I) (matrix κ n I B))) :=
  (quotientChart R κ n I B).trans
    ((ActualTransverseClosed.fullToLocal R (Selected n I) (Other n I ⊕ κ) (Other n I)
      Sum.inl (matrix κ n I B) (matrix_zero_block κ n I B hpos hneg hsupport hI)).trans
      (ExchangeZeroFiber.affineEquiv (R := R) _))

theorem affineEquiv_mk (z : BasicOpen R κ n I B) :
    affineEquiv R κ n I B hpos hneg hsupport hI (Ideal.Quotient.mk (zeroIdeal R κ n I B) z) =
      ExchangeZeroFiber.toAffineRaw (R := R) _
        (globalOpenEquiv R (Selected n I) (Other n I ⊕ κ) (Other n I)
          Sum.inl (matrix κ n I B) (matrix_zero_block κ n I B hpos hneg hsupport hI)
          (chartEquiv R κ n I B z)) := by
  rfl

#print axioms map_zeroIdeal
#print axioms zeroLayerAlgebra
#print axioms quotientChart
#print axioms quotientChart_mk
#print axioms originalStratumEquiv
#print axioms affineEquiv
#print axioms affineEquiv_mk
end Verification.IndependentStratumCoordinates
