import Mathlib.Tactic
import Mathlib.Algebra.BigOperators.Group.List.Basic

/-!
# Run transfers in the path-contraction argument

This file verifies the combinatorics at manuscript.tex, lines 1601--1624.
For a binary word with at least one vacancy, the list of run lengths has
one more entry than the number of vacancies. The move `110 ↔ 011`
transfers two selected positions between adjacent runs. `RunConnected`
is exactly the equivalence relation generated by these adjacent transfers.

The main theorem `runConnected_iff` proves, for arbitrarily long run lists,
that equal weight and equal coordinatewise parity characterize connectivity.
The final theorem checks the claimed normalization of the slide coefficient
in any monoid with an element `g` satisfying `g * g = 1`.

This does not identify these combinatorial objects with the geometric
cellular complex, prove its chain identity, or prove the path-vanishing
theorem for strictly A¹-invariant sheaves.
-/

namespace Verification.Path

/-- Connectivity under the transfer of two units between neighboring runs. -/
inductive RunConnected : List ℕ → List ℕ → Prop
  | refl (a) : RunConnected a a
  | slide (a b : ℕ) (tail : List ℕ) :
      RunConnected ((a + 2) :: b :: tail) (a :: (b + 2) :: tail)
  | symm {a b} : RunConnected a b → RunConnected b a
  | trans {a b c} : RunConnected a b → RunConnected b c → RunConnected a c
  | prepend (a : ℕ) {b c} : RunConnected b c → RunConnected (a :: b) (a :: c)

/-- The parity vector of run lengths. -/
def parities (a : List ℕ) : List ℕ := a.map (· % 2)

/-- Number of movable pairs remaining after subtracting the parity vector. -/
def pairCount (a : List ℕ) : ℕ := (a.map (· / 2)).sum

theorem runConnected_parities {a b : List ℕ} (h : RunConnected a b) :
    parities a = parities b := by
  induction h with
  | refl => rfl
  | slide a b tail => simp [parities, Nat.add_mod]
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | prepend a _ ih => simpa [parities] using congrArg (List.cons (a % 2)) ih

theorem runConnected_sum {a b : List ℕ} (h : RunConnected a b) :
    a.sum = b.sum := by
  induction h with
  | refl => rfl
  | slide a b tail => simp only [List.sum_cons]; omega
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | prepend a _ ih => simpa only [List.sum_cons] using congrArg (a + ·) ih

theorem sum_eq_parity_add_pairs (a : List ℕ) :
    a.sum = (parities a).sum + 2 * pairCount a := by
  induction a with
  | nil => simp [parities, pairCount]
  | cons a tail ih =>
      simp only [List.sum_cons, parities, List.map_cons, pairCount] at *
      omega

/-- Moving `k` pairs left is a finite sequence of single-pair slides. -/
theorem transfer_pairs_left (a b k : ℕ) (tail : List ℕ) :
    RunConnected (a :: (b + 2 * k) :: tail) ((a + 2 * k) :: b :: tail) := by
  induction k generalizing a with
  | zero => simpa using RunConnected.refl (a :: b :: tail)
  | succ k ih =>
      have first := RunConnected.symm (RunConnected.slide a (b + 2 * k) tail)
      have rest := ih (a + 2)
      have result := RunConnected.trans first rest
      have hs : b + 2 * (k + 1) = (b + 2 * k) + 2 := by omega
      have ht : a + 2 * (k + 1) = (a + 2) + 2 * k := by omega
      simpa only [hs, ht] using result

/-- Normal form places every movable pair in the first run. -/
def packPairs (p : List ℕ) (k : ℕ) : List ℕ :=
  match p with
  | [] => []
  | a :: tail => (a + 2 * k) :: tail

theorem connected_normal_form (a : List ℕ) :
    RunConnected a (packPairs (parities a) (pairCount a)) := by
  induction a with
  | nil => exact RunConnected.refl []
  | cons a tail ih =>
      cases tail with
      | nil =>
          have ha : a = a % 2 + 2 * (a / 2) := by omega
          simpa [packPairs, parities, pairCount, ← ha] using RunConnected.refl [a]
      | cons b tail =>
          have first := RunConnected.prepend a ih
          have second := transfer_pairs_left a (b % 2) (pairCount (b :: tail))
            (parities tail)
          have result := RunConnected.trans first second
          have ha : a + 2 * pairCount (b :: tail) =
              a % 2 + 2 * pairCount (a :: b :: tail) := by
            simp only [pairCount, List.map_cons, List.sum_cons]
            omega
          simpa only [parities, List.map_cons, packPairs, ← ha] using result

/-- The manuscript's parity classification of slide components. -/
theorem runConnected_iff (a b : List ℕ) :
    RunConnected a b ↔ parities a = parities b ∧ a.sum = b.sum := by
  constructor
  · intro h
    exact ⟨runConnected_parities h, runConnected_sum h⟩
  · rintro ⟨hp, hs⟩
    have hc : pairCount a = pairCount b := by
      have ha := sum_eq_parity_add_pairs a
      have hb := sum_eq_parity_add_pairs b
      rw [hp] at ha
      omega
    have hnormal : packPairs (parities a) (pairCount a) =
        packPairs (parities b) (pairCount b) := by rw [hp, hc]
    exact RunConnected.trans (connected_normal_form a)
      (hnormal ▸ RunConnected.symm (connected_normal_form b))

/-- A transfer may be performed after any unchanged prefix. -/
theorem runConnected_prefix (pre : List ℕ) {a b : List ℕ}
    (h : RunConnected a b) : RunConnected (pre ++ a) (pre ++ b) := by
  induction pre with
  | nil => simpa using h
  | cons x tail ih => simpa using RunConnected.prepend x ih

/-- An odd run with a following neighbor can be reduced to a singleton. -/
theorem odd_run_to_singleton_right (pre tail : List ℕ) (a b : ℕ)
    (ha : a % 2 = 1) :
    RunConnected (pre ++ a :: b :: tail)
      (pre ++ 1 :: (b + 2 * (a / 2)) :: tail) := by
  have decomp : 1 + 2 * (a / 2) = a := by omega
  have h := RunConnected.symm (transfer_pairs_left 1 b (a / 2) tail)
  rw [decomp] at h
  exact runConnected_prefix pre h

/-- The terminal odd run can be reduced using its preceding neighbor. -/
theorem odd_run_to_singleton_left (pre tail : List ℕ) (a b : ℕ)
    (hb : b % 2 = 1) :
    RunConnected (pre ++ a :: b :: tail)
      (pre ++ (a + 2 * (b / 2)) :: 1 :: tail) := by
  have decomp : 1 + 2 * (b / 2) = b := by omega
  have h := transfer_pairs_left a 1 (b / 2) tail
  rw [decomp] at h
  exact runConnected_prefix pre h

/-- A slide shifts the sum of selected indices by two. -/
theorem slide_index_sum (outside i : ℕ) :
    outside + (i + 1) + (i + 2) = (outside + i + (i + 1)) + 2 := by omega

/-- The exponent used for the basis change increases by one per slide. -/
theorem slide_exponent (s : ℕ) : (s + 2) / 2 = s / 2 + 1 := by omega

/-- The basis change in the manuscript removes a slide coefficient `g`. -/
theorem slide_basis_sign {M : Type*} [Monoid M] (g : M) (hg : g * g = 1) (s : ℕ) :
    g ^ ((s + 2) / 2) * g = g ^ (s / 2) := by
  rw [slide_exponent, pow_succ, mul_assoc, hg, mul_one]

#print axioms runConnected_parities
#print axioms runConnected_sum
#print axioms sum_eq_parity_add_pairs
#print axioms transfer_pairs_left
#print axioms connected_normal_form
#print axioms runConnected_iff
#print axioms runConnected_prefix
#print axioms odd_run_to_singleton_right
#print axioms odd_run_to_singleton_left
#print axioms slide_index_sum
#print axioms slide_exponent
#print axioms slide_basis_sign

end Verification.Path

